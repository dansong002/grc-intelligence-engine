# Optional: enables the "Deepen with AI" feature.
# Without a key, the curated baseline stands on its own — the AI layer is additive.
#
# Provider: "anthropic" (default) or "openai" (also covers Azure OpenAI, OpenRouter, local).
# If VITE_AI_PROVIDER is unset, the engine defaults to Anthropic when a key is present.
VITE_AI_PROVIDER=anthropic

# API key for the chosen provider.
# Anthropic: https://console.anthropic.com/
# OpenAI:    https://platform.openai.com/api-keys
VITE_AI_API_KEY=

# Optional: override the base URL (useful for Azure OpenAI, OpenRouter, or local models).
# Anthropic default: https://api.anthropic.com   (handled internally)
# OpenAI default:    https://api.openai.com/v1
# VITE_AI_BASE_URL=

# Optional: override the model name.
# Anthropic default: claude-sonnet-4-6
# OpenAI default:    gpt-4o
# VITE_AI_MODEL=

# SECURITY WARNING: Vite bundles VITE_* variables into the client-side build.
# Anyone who can view-source your deployed site can see the key.
# Do NOT deploy with a real key set unless behind authentication.
